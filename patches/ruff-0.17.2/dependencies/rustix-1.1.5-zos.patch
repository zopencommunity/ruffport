+            target_os = "wasi",
+        ))]
+        const RSYNC = bitcast!(c::O_RSYNC);
+
+        /// `O_SYNC`
+        #[cfg(not(any(target_os = "l4re", target_os = "redox")))]
+        const SYNC = bitcast!(c::O_SYNC);
+
+        /// `O_TRUNC`
+        const TRUNC = bitcast!(c::O_TRUNC);
+
+        /// `O_PATH`
+        #[cfg(any(
+            linux_kernel,
+            target_os = "emscripten",
+            target_os = "freebsd",
+            target_os = "fuchsia",
+            target_os = "redox",
+        ))]
